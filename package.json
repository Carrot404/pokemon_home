{
  "name": "pokemon_home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "password:hash": "node server/hash-password.mjs",
    "data:generate": "node scripts/generate-data.mjs",
    "data:check": "node scripts/check-data.mjs",
    "test:server": "node --test server/server.test.mjs",
    "test:sync-state": "node --test src/lib/pendingChanges.test.js",
    "test": "npm run data:check && npm run test:server && npm run test:sync-state"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
